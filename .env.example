# Copy this file to .env and fill in real values.
# Every var here is EXPO_PUBLIC_-prefixed because Expo only inlines
# process.env values with that prefix into the client bundle — see
# https://docs.expo.dev/guides/environment-variables/
# None of these are secret in the "never expose" sense (anon key + publishable
# purchase keys are designed to ship in a client), but they are
# environment-specific and should not be committed.

# Supabase project settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog project settings -> Project API Key (leave unset to disable analytics)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# RevenueCat project settings -> API Keys (public SDK keys, platform-specific)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
