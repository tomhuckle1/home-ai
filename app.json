{
  "expo": {
    "name": "Home Memory",
    "slug": "home-memory",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homememory",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.homememory.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Home Memory uses your camera to photograph appliance labels, receipts, manuals and certificates so it can build your home's record.",
        "NSPhotoLibraryUsageDescription": "Home Memory lets you pick existing photos of receipts, manuals and appliances from your library.",
        "NSPhotoLibraryAddUsageDescription": "Home Memory can save copies of photos you take to your library."
      }
    },
    "android": {
      "package": "uk.co.homememory.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F3EE"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Home Memory uses your camera to photograph appliance labels, receipts, manuals and certificates so it can build your home's record."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Home Memory lets you pick existing photos of receipts, manuals and appliances from your library."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2F6F4E"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
